{
  "name": "industrial-telemetry-backend",
  "version": "0.0.1",
  "description": "Industrial telemetry backend: Kafka, stores, BFF",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "build:all": "nest build bff && nest build core-api && nest build telemetry-generator && nest build telemetry-consumer && nest build alert-consumer",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"*.{json,mjs,yml}\" \"docker-compose.yml\"",
    "format:check": "prettier --check \"apps/**/*.ts\" \"libs/**/*.ts\" \"*.{json,mjs,yml}\" \"docker-compose.yml\"",
    "start": "nest start bff",
    "start:bff": "nest start bff",
    "start:bff:dev": "nest start bff --watch",
    "start:core-api": "nest start core-api",
    "start:core-api:dev": "nest start core-api --watch",
    "start:generator": "nest start telemetry-generator",
    "start:generator:dev": "nest start telemetry-generator --watch",
    "start:telemetry-consumer": "nest start telemetry-consumer",
    "start:telemetry-consumer:dev": "nest start telemetry-consumer --watch",
    "start:alert-consumer": "nest start alert-consumer",
    "start:alert-consumer:dev": "nest start alert-consumer --watch",
    "start:dev": "nest start bff --watch",
    "start:debug": "nest start bff --debug --watch",
    "start:prod": "node dist/apps/bff/main",
    "dev:apps": "concurrently -k -n core,bff,tcons,acons,gen -c blue,magenta,green,yellow,cyan \"npm:start:core-api:dev\" \"npm:start:bff:dev\" \"npm:start:telemetry-consumer:dev\" \"npm:start:alert-consumer:dev\" \"npm:start:generator:dev\"",
    "dev:api": "concurrently -k -n core,bff -c blue,magenta \"npm:start:core-api:dev\" \"npm:start:bff:dev\"",
    "dev": "npm run infra:up && npm run dev:apps",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "lint:check": "eslint \"{apps,libs}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:ps": "docker compose ps",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "kafkajs": "^2.2.4",
    "mongodb": "^7.5.0",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tarantool-driver": "^3.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.20.0"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/tsconfig.spec.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@it/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@it/prisma(|/.*)$": "<rootDir>/libs/prisma/src/$1"
    }
  }
}
