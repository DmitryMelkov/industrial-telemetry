generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  operator
  admin
}

enum MetricType {
  temperature
  pressure
  vibration
  flow
}

enum AlertSeverity {
  warning
  critical
}

enum AlertStatus {
  open
  acked
  resolved
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("users")
}

model Site {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lines     Line[]

  @@map("sites")
}

model Line {
  id      String   @id @default(uuid()) @db.Uuid
  siteId  String   @map("site_id") @db.Uuid
  code    String
  name    String
  site    Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  sensors Sensor[]

  @@unique([siteId, code])
  @@map("lines")
}

model Sensor {
  id         String            @id @default(uuid()) @db.Uuid
  lineId     String            @map("line_id") @db.Uuid
  code       String
  name       String
  metric     MetricType
  unit       String
  isActive   Boolean           @default(true) @map("is_active")
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  line       Line              @relation(fields: [lineId], references: [id], onDelete: Cascade)
  thresholds SensorThreshold[]
  alerts     Alert[]

  @@unique([lineId, code])
  @@map("sensors")
}

model SensorThreshold {
  id       String        @id @default(uuid()) @db.Uuid
  sensorId String        @map("sensor_id") @db.Uuid
  minValue Decimal?      @map("min_value") @db.Decimal(12, 4)
  maxValue Decimal?      @map("max_value") @db.Decimal(12, 4)
  severity AlertSeverity
  sensor   Sensor        @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  @@map("sensor_thresholds")
}

model Alert {
  id         String        @id @default(uuid()) @db.Uuid
  sensorId   String        @map("sensor_id") @db.Uuid
  severity   AlertSeverity
  status     AlertStatus   @default(open)
  message    String
  value      Decimal       @db.Decimal(12, 4)
  openedAt   DateTime      @default(now()) @map("opened_at") @db.Timestamptz(6)
  resolvedAt DateTime?     @map("resolved_at") @db.Timestamptz(6)
  sensor     Sensor        @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  @@index([status, openedAt])
  @@index([sensorId])
  @@map("alerts")
}
