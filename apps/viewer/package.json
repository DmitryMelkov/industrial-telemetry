{
  "name": "industrial-telemetry-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "lint": "oxlint src --fix",
    "lint:check": "oxlint src",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"*.{json,mjs,md}\" \".prettierrc\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"*.{json,mjs,md}\" \".prettierrc\"",
    "preview": "vite preview"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@tanstack/vue-query": "^5.104.0",
    "axios": "^1.20.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4",
    "vuetify": "^4.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.105.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^3.3.11"
  }
}
