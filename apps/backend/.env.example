# PostgreSQL
POSTGRES_USER=telemetry
POSTGRES_PASSWORD=telemetry
POSTGRES_DB=telemetry
POSTGRES_PORT=5432
DATABASE_URL=postgresql://telemetry:telemetry@localhost:5432/telemetry

# MongoDB
MONGO_PORT=27017
MONGO_URL=mongodb://localhost:27017/telemetry

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Tarantool
TARANTOOL_PORT=3301
TARANTOOL_HOST=localhost
TARANTOOL_PORT_CLIENT=3301

# Kafka (с хоста — EXTERNAL listener)
KAFKA_PORT=9092
KAFKA_BROKERS=localhost:9092
# из контейнеров друг к другу: kafka:29092
KAFKA_BROKERS_DOCKER=kafka:29092

# Kafka UI
KAFKA_UI_PORT=8088

# Apps
BFF_PORT=3000
CORE_API_PORT=3001
CORE_API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:4200,http://localhost:5173

# telemetry-generator
GENERATOR_INTERVAL_MS=1000
GENERATOR_SENSOR_REFRESH_MS=10000

# alert-consumer anti-flap (seconds; 0 = immediately)
ALERT_OPEN_DEBOUNCE_SECONDS=20
ALERT_RESOLVE_HYSTERESIS_SECONDS=20
