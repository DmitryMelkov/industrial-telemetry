{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/bff/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/bff/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/bff",
  "projects": {
    "bff": {
      "type": "application",
      "root": "apps/bff",
      "entryFile": "main",
      "sourceRoot": "apps/bff/src",
      "compilerOptions": {
        "tsConfigPath": "apps/bff/tsconfig.app.json"
      }
    },
    "core-api": {
      "type": "application",
      "root": "apps/core-api",
      "entryFile": "main",
      "sourceRoot": "apps/core-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/core-api/tsconfig.app.json"
      }
    },
    "telemetry-generator": {
      "type": "application",
      "root": "apps/telemetry-generator",
      "entryFile": "main",
      "sourceRoot": "apps/telemetry-generator/src",
      "compilerOptions": {
        "tsConfigPath": "apps/telemetry-generator/tsconfig.app.json"
      }
    },
    "telemetry-consumer": {
      "type": "application",
      "root": "apps/telemetry-consumer",
      "entryFile": "main",
      "sourceRoot": "apps/telemetry-consumer/src",
      "compilerOptions": {
        "tsConfigPath": "apps/telemetry-consumer/tsconfig.app.json"
      }
    },
    "alert-consumer": {
      "type": "application",
      "root": "apps/alert-consumer",
      "entryFile": "main",
      "sourceRoot": "apps/alert-consumer/src",
      "compilerOptions": {
        "tsConfigPath": "apps/alert-consumer/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "prisma": {
      "type": "library",
      "root": "libs/prisma",
      "entryFile": "index",
      "sourceRoot": "libs/prisma/src",
      "compilerOptions": {
        "tsConfigPath": "libs/prisma/tsconfig.lib.json"
      }
    }
  }
}
